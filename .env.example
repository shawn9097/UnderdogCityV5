# ── Email capture ────────────────────────────────────────────────────────────
# Beehiiv forwarding activates automatically once both are set.
# Signups are ALWAYS stored in Supabase regardless, so nothing is lost.
BEEHIIV_API_KEY=
BEEHIIV_PUB_ID=

# ── Supabase (durable signup store) ──────────────────────────────────────────
# Optional overrides. Safe defaults for the underdog-city project are baked in;
# the publishable key is public by design (RLS: insert-only on public.signups).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Analytics ────────────────────────────────────────────────────────────────
# Plausible loads only in production builds.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=theunderdogcity.com
